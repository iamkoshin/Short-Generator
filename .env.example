# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
# Tried in order; a model that hits its free daily limit is skipped until midnight Pacific.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# true = extra LLM request per video to classify it (podcast, tutorial...) before picking highlights
LLM_DETECT_CONTENT_TYPE=false
# Give up on a Gemini model that hasn't answered after this many seconds and try the next one
GEMINI_TIMEOUT_SECONDS=150
# Largest video you can upload from the browser, in MB
MAX_UPLOAD_MB=4096
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output
